% LuaLaTeX 用 kian 互換レイヤー
%
% 目的：kian のサブ sty が pTeX 固有の skip レジスタとして使っていた
%   \kanjiskip / \xkanjiskip をTeXスキップレジスタとして新規定義し、
%   kian 内部の寸法計算・\hskip 等が動作するようにする。
%
% luatexja が管理する本物の kanjiskip（文字間自動グルー）は ltjsarticle が
% 設定するものをそのまま使い、kian 内部用はこの互換レジスタで独立管理する。
%
% また kian-page が使う dvipdfmx 専用の \special{pdf:…} は、LuaTeX では
% 内容ストリームへそのまま literal 出力されて不正な PDF 演算子となるため、
% kian-page.sty 側で個別に除去してある（このファイルでは扱わない）。

\ProvidesPackage{kian-base}[2026/07/23 v1.0 kian LuaLaTeX compat layer]

%==============================================================================%
% LuaLaTeX / luatexja 確認

\RequirePackage{iftex}
\ifLuaTeX\else
  \PackageError{kian-base}{kian-lua は LuaLaTeX 専用です}{}
\fi

%==============================================================================%
% \kanjiskip / \xkanjiskip 互換スキップレジスタ
%
% kian-page.sty の初期化コード（96-100 行目）と同値で初期化する。
% \zw は luatexja が ltjsarticle を読み込んだ時点で定義済み。

\newskip\kanjiskip
\newskip\xkanjiskip

% kian-page.sty の初期値（jsarticle 標準相当）
\kanjiskip=.03\zw plus .300\zw minus .030\zw
\xkanjiskip=\kanjiskip
\advance\xkanjiskip by +.5\zw\relax
\setbox\z@=\hbox{0}\advance\xkanjiskip by -.5\wd\z@\relax

%==============================================================================%
% dvipdfmx 専用命令について（注意書き）
%
% ※ かつてここに次のコードがあったが、いずれの意味でも誤りだったため削除した
%    （2026-08-26）:
%      \@ifundefined{AtBeginDvi}{\newcommand{\AtBeginDvi}[1]{}}{}
%
%    (1) \AtBeginDvi は LaTeX2e カーネルの標準命令であって uplatex 固有ではない。
%        したがって \@ifundefined は常に偽となり、この無効化は一度も発動しない
%        デッドコードだった。
%    (2) 仮に発動したとしても \AtBeginDvi を潰してはならない。hyperref 等が
%        正当に使用するため。
%
%    実際に問題だったのは \AtBeginDvi ではなく、その中身の dvipdfmx 専用命令
%    \special{pdf:tounicode EUC-UCS2} の方である。LuaTeX の PDF バックエンドは
%    \special{pdf:…} の「pdf:」以降を内容ストリームへ literal 出力するため、
%    不正な PDF 演算子としてページ１に残り、Adobe Acrobat が
%    「このページにはエラーがあります」を表示していた。
%    → kian-page.sty 側でコメントアウト済み。
%
%    LuaLaTeX 版で dvipdfmx 専用の \special{pdf:…} を新たに書いてはならない。

\endinput
